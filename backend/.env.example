# Copy this file to backend/.env on the server and fill in the keys.
# Do not commit backend/.env.

# Required. From https://aistudio.google.com/apikey
# Used for embeddings and, unless LLM_PROVIDER=groq, for answers.
GOOGLE_API_KEY=

# gemini (default) or groq
LLM_PROVIDER=gemini

# Only required when LLM_PROVIDER=groq. From https://console.groq.com/keys
GROQ_API_KEY=

# Chat model when LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Embedding model. text-embedding-004 was shut down in January 2026.
GEMINI_EMBED_MODEL=gemini-embedding-2

# low, medium, high, or off. low keeps a live demo from waiting on long reasoning.
# If the model rejects the field, the server retries once without it.
GEMINI_THINKING_LEVEL=low

# Chat model when LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Vector length requested from Gemini. 768, 1536, and 3072 are the recommended sizes.
# If you change this after uploading files, delete those files and upload them again.
EMBED_DIM=768

# Character window and the overlap between neighboring windows.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# How many chunks are sent to the answer model.
TOP_K=4

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10

# Comma-separated browser origins, or * for any origin.
# Example after the Vercel deploy: https://your-demo.vercel.app
CORS_ORIGINS=*

# Folder for rag.sqlite. Defaults to backend/data when unset.
# DATA_DIR=
